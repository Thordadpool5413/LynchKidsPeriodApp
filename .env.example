# Email delivery (required in production — choose one option):
# Option A: Any nodemailer-compatible SMTP URL (Resend, Postmark, SendGrid, etc.)
#   SMTP_URL=smtp://resend:YOUR_API_KEY@smtp.resend.com:587
# Option B: Resend via Replit Connectors (no manual key needed — connect the integration in Replit)
#   (leave SMTP_URL unset and add the Resend connector to your Repl)
SMTP_URL=
# Sender address shown on magic-link emails.
# PREREQUISITE: mail.glitter.app must be DNS-verified in the Resend dashboard (resend.com/domains)
# before the address below will be accepted. Until then, Resend will reject outbound mail.
# Local / pre-verification fallback: EMAIL_FROM=onboarding@resend.dev (no DNS setup needed)
EMAIL_FROM=noreply@mail.glitter.app
