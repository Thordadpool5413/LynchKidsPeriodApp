{
  "name": "avacado-period-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "api": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "api:production": "tsx server/production-start.ts",
    "dev": "concurrently -n app,api -c magenta,cyan \"npm run web\" \"npm run api\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "notifications:send": "tsx server/jobs/send-notifications.ts",
    "deploy:verify": "npm run check && npm run web:export && npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@replit/connectors-sdk": "^0.4.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "expo": "55.0.28",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-local-authentication": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "express": "^5.1.0",
    "nodemailer": "^9.0.3",
    "openai": "^5.20.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "~19.2.10",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "js-yaml": "5.2.3"
  }
}
