{
  "expo": {
    "name": "AvaCado",
    "slug": "avacado-period-app",
    "scheme": "avacado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/avacado-app-icon.png",
    "splash": {
      "image": "./assets/brand/avacado-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3D7"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lynchkids.avacado",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "AvaCado can send private Glitter reminders using words you choose."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/avacado-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "defaultChannel": "gentle-reminders"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://lynch-kids-period-app.replit.app",
      "router": {},
      "eas": {
        "projectId": "89501886-8bbd-4516-9eaa-cb3efe891ffc"
      }
    },
    "owner": "thordadpool",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/89501886-8bbd-4516-9eaa-cb3efe891ffc"
    },
    "android": {
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    }
  }
}
